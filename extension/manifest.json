{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Readown",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.markdown",
        "file:///*.mdown",
        "file:///*.mkd",
        "file:///*.mkdn",
        "https://raw.githubusercontent.com/*.md",
        "https://raw.githubusercontent.com/*.md?*",
        "https://raw.githubusercontent.com/*.markdown",
        "https://gist.githubusercontent.com/*.md",
        "https://gist.githubusercontent.com/*.md?*",
        "https://gist.githubusercontent.com/*.markdown",
        "https://gitlab.com/*/-/raw/*.md",
        "https://gitlab.com/*/-/raw/*.md?*",
        "https://gitlab.com/*/-/raw/*.markdown",
        "https://bitbucket.org/*/raw/*.md",
        "https://bitbucket.org/*/raw/*.md?*",
        "https://bitbucket.org/*/raw/*.markdown"
      ],
      "js": [
        "vendor/marked.umd.js",
        "vendor/purify.min.js",
        "vendor/highlight.min.js",
        "src/render.js",
        "src/content.js"
      ],
      "css": [
        "vendor/github-markdown.css",
        "src/viewer.css"
      ],
      "run_at": "document_end"
    }
  ]
}
